{
  "name": "yoda",
  "version": "0.3.0",
  "description": "Terse Yoda-voice replies for Claude Code. Cuts filler to save output tokens; code, commands, paths and errors stay verbatim.",
  "author": {
    "name": "Héctor Tarrido-Picart",
    "url": "https://github.com/htarrido-picart"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/htarrido-picart/yoda",
  "repository": "https://github.com/htarrido-picart/yoda",
  "keywords": [
    "tokens",
    "brevity",
    "style",
    "yoda"
  ],
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/yoda.py\" subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/yoda.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
